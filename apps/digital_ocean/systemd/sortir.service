[Unit]
Description=Sortir Phoenix Application
After=network.target

[Service]
Type=exec
User=sortir
Group=sortir
WorkingDirectory=/opt/sortir
EnvironmentFile=/opt/sortir/.env
Environment="MIX_ENV=prod"
Environment="LANG=en_US.UTF-8"
Environment="LC_ALL=en_US.UTF-8"

# No ExecStartPre: this app has no database and nothing to migrate.
ExecStart=/opt/sortir/bin/server

Restart=always
RestartSec=5
StartLimitIntervalSec=60
StartLimitBurst=3

StandardOutput=journal
StandardError=journal
SyslogIdentifier=sortir

# The droplet has ~2 GB with ~1 GB free, so this is roomy rather than tight.
# Measured ~113 MB at idle after warming 7 days of showtimes: an earlier 150M
# cap left it permanently above MemoryHigh, i.e. throttled by the kernel.
MemoryMax=300M
MemoryHigh=250M
MemorySwapMax=128M

CPUQuota=40%

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/sortir

[Install]
WantedBy=multi-user.target
